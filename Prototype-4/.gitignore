# C++ Build Output
build/
build_cmake*/
*.ninja
*.ninja_deps
*.ninja_log
*.exe
*.o
*.obj

# Python Cache
__pycache__/
*.py[cod]

# Binary Index Data (large, generated by Build.exe)
DataStorage/*.bin
DataStorage/*.tmp

# PDF Storage (user data, not committed)
ingestor/

# Large ML Model Weights
*.safetensors
models/**/model_cache/
*.cl_cache
*.blob

# Editor & OS Files
.vscode/
.DS_Store
Thumbs.db

# Generated benchmark reports
docs/*_report.md
docs/*_profile.md
